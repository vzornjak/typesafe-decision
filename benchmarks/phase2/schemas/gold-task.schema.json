{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vzornjak/typesafe-decision/benchmarks/phase2/schemas/gold-task.schema.json",
  "title": "Phase 2 sealed gold task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "required_source_ids", "primary_source_ids", "requirements"],
  "properties": {
    "task_id": {"type": "string"},
    "required_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "primary_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement_id", "supporting_source_ids", "support_spans"],
        "properties": {
          "requirement_id": {"type": "string"},
          "supporting_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "support_spans": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["candidate_id", "start", "end", "text_sha256"],
              "properties": {
                "candidate_id": {"type": "string"},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1},
                "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "known_contradictions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "description"],
        "properties": {"candidate_id": {"type": "string"}, "description": {"type": "string"}}
      }
    }
  }
}
